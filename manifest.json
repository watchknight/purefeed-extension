{
  "manifest_version": 3,
  "name": "PureFeed - Clean Feed & Ad Blocker",
  "version": "2.2",
  "description": "Professional browser extension that hides short-form video feeds and advertisements.",
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    },
    "default_title": "PureFeed - Clean Feed & Ad Blocker"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "declarativeNetRequest",
    "storage"
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "ad_block_rules",
        "enabled": true,
        "path": "rules.json"
      }
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "*://youtube.com/*",
        "*://*.youtube.com/*"
      ],
      "css": ["youtube.css"],
      "js": ["youtube.js"],
      "run_at": "document_start"
    },
    {
      "matches": [
        "*://facebook.com/*",
        "*://*.facebook.com/*"
      ],
      "css": ["facebook.css"],
      "js": ["facebook.js"],
      "run_at": "document_start"
    }
  ]
}
